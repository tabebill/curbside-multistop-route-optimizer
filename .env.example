# Browser key for Google Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Server key for Geocoding API. Keep this server-only.
GOOGLE_MAPS_SERVER_KEY=

# Google Cloud project that has Route Optimization API enabled.
GOOGLE_CLOUD_PROJECT_ID=

# Local development path to a service-account JSON file.
# Keep the JSON file outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=

# Cloud Storage bucket used by Route Optimization batch jobs.
GOOGLE_ROUTE_OPTIMIZATION_BUCKET=

# Optional async Route Optimization solver timeout, in seconds.
# Defaults to 1800 seconds and is capped at Google's 30-minute max.
GOOGLE_ROUTE_OPTIMIZATION_BATCH_TIMEOUT_SECONDS=1800

# Optional/legacy compatibility values.
GOOGLE_MAPS_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_ROE_SERVICE_ACCOUNT=
