{
  "name": "curbside-multistop-route-optimizer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "benchmark:routes": "tsx scripts/benchmark-route-optimizer.ts",
    "benchmark:routes:5000": "ROUTE_BENCHMARK_STOPS=5000 tsx scripts/benchmark-route-optimizer.ts",
    "benchmark:routes:5000:all": "ROUTE_BENCHMARK_STOPS=5000 ROUTE_BENCHMARK_MODE=google_optimized tsx scripts/benchmark-route-optimizer.ts && ROUTE_BENCHMARK_STOPS=2000 ROUTE_BENCHMARK_MODE=curbside_strict tsx scripts/benchmark-route-optimizer.ts",
    "benchmark:routes:5000:shuffles": "ROUTE_BENCHMARK_STOPS=5000 ROUTE_BENCHMARK_SHUFFLES=2 ROUTE_BENCHMARK_MODE=google_optimized tsx scripts/benchmark-route-optimizer.ts",
    "benchmark:routes:5000:shuffles:selected-end": "ROUTE_BENCHMARK_STOPS=5000 ROUTE_BENCHMARK_SHUFFLES=1 ROUTE_BENCHMARK_END_MODE=selected_stop ROUTE_BENCHMARK_MODE=google_optimized tsx scripts/benchmark-route-optimizer.ts",
    "benchmark:routes:5000:shuffles:round-trip": "ROUTE_BENCHMARK_STOPS=5000 ROUTE_BENCHMARK_SHUFFLES=1 ROUTE_BENCHMARK_END_MODE=round_trip ROUTE_BENCHMARK_MODE=google_optimized tsx scripts/benchmark-route-optimizer.ts",
    "verify:sample-route": "tsx scripts/verify-sample-route.ts",
    "verify:sample-shuffles": "tsx scripts/verify-sample-shuffles.ts",
    "verify:sample-shuffles:selected-end": "ROUTE_SAMPLE_END_MODE=selected_stop tsx scripts/verify-sample-shuffles.ts",
    "verify:sample-shuffles:round-trip": "ROUTE_SAMPLE_END_MODE=round_trip tsx scripts/verify-sample-shuffles.ts",
    "verify:sample-ui": "tsx scripts/verify-sample-ui.ts",
    "test": "tsx --test src/**/*.test.ts",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@googlemaps/js-api-loader": "^2.0.2",
    "@googlemaps/markerclusterer": "^2.6.2",
    "google-auth-library": "^10.6.2",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "papaparse": "^5.5.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
